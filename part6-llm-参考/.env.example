# 这是模板文件。用法：
#   1. 复制一份，命名为 .env（注意前面有个点，没有后缀名）
#   2. 把下面的值改成你自己的
#   3. .env 永远不要提交到 git / 发给别人，只有 .env.example 可以公开

# 你的模型 API Key
LLM_API_KEY=在这里填你的APIKey

# 模型服务的接入地址（OpenAI 兼容格式）。
# 下面填的是 DeepSeek 的例子，如果你用的是其它厂商，换成对应的地址。
LLM_BASE_URL=https://api.deepseek.com/v1

# 模型名称
LLM_MODEL=deepseek-chat

# 单次请求超时时间（秒）
LLM_TIMEOUT=30
